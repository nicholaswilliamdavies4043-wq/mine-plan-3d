# Copy to .env and adjust.

# API port (the Vite dev server proxies /api to it)
PORT=4000

# Data store: "file" (default, JSON under ./data, zero setup) or "prisma" (PostgreSQL)
DATA_STORE=file
# DATABASE_URL=postgresql://mineplan:mineplan@localhost:5432/mineplan?schema=public

# Object storage for plans and 3D assets: "local" (./data/storage) or "s3" (any S3-compatible store)
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=eu-north-1
# S3_ENDPOINT=            # e.g. http://localhost:9000 for MinIO
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=mine-plan-3d/

MAX_UPLOAD_MB=200
