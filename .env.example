# Copy to .env and adjust.

# API port (the Vite dev server proxies /api to it). Render sets PORT itself.
PORT=4000

# PostgreSQL. When DATABASE_URL is set the server uses PostgreSQL automatically: it creates its
# tables on start-up and also keeps plan images and 3D asset files in the database.
# On Render use the database's Internal Database URL (or let render.yaml wire it).
# DATABASE_URL=postgresql://mineplan:mineplan@localhost:5432/mineplan
# TLS: automatic (on for remote hosts such as *.render.com). Force with DATABASE_SSL=true / false.
# DATABASE_SSL=

# Data store override: "postgres" (default with DATABASE_URL), "file" (JSON under ./data, the
# default without DATABASE_URL) or "prisma" (PostgreSQL through Prisma; needs generate + migrate).
# DATA_STORE=

# File storage override: "postgres" (default with DATABASE_URL), "local" (./data/storage) or "s3".
# STORAGE_DRIVER=
# S3_BUCKET=
# S3_REGION=eu-north-1
# S3_ENDPOINT=            # e.g. http://localhost:9000 for MinIO
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=mine-plan-3d/

MAX_UPLOAD_MB=200

# Keep-alive: the server requests its own public /api/health every KEEP_ALIVE_MINUTES (default 11)
# so a free Render instance (which sleeps after 15 idle minutes) stays awake. On Render it uses
# RENDER_EXTERNAL_URL automatically. Elsewhere set the public URL here; KEEP_ALIVE=false disables it.
# KEEP_ALIVE_URL=https://your-app.onrender.com
# KEEP_ALIVE_MINUTES=11
# KEEP_ALIVE=false
