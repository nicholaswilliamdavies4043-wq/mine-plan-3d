// PostgreSQL schema. Used when DATA_STORE=prisma (or DATABASE_URL is set).
// Nested editable structures (georef, regions, network, asset metadata) are Json columns:
// they are always read and written as a whole by the editor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id
  name        String
  description String?
  kitId       String?
  profile     Json
  items       Json?
  measurements Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plans       Plan[]
}

model Plan {
  id            String   @id
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  imageKey      String
  imageMime     String
  imageWidth    Int
  imageHeight   Int
  levelRL       Float
  georef        Json
  regions       Json
  excludes      Json
  params        Json
  network       Json
  measurements  Json?
  lastDetection Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

model Asset {
  id               String   @id
  name             String
  category         String
  files            Json
  mainFile         String
  thumbnailKey     String?
  meta             Json
  sourceUrl        String?
  license          String?
  licenseConfirmed Boolean  @default(false)
  tags             String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Kit {
  id                String   @id
  name              String
  description       String?
  slots             Json
  decorations       Json
  angleToleranceDeg Float    @default(20)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
